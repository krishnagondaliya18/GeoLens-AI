# GeoLens Backend Configuration

# API Execution Engine: "gemini" (Default) | "custom" (Local VQA cluster) | "openai"
API_MODE=gemini

# Google Gemini Vision API Key
# Get your API key at: https://aistudio.google.com/
GEMINI_API_KEY=your_gemini_api_key_here

# Gemini Vision Model (gemini-2.5-flash, gemini-2.0-flash, gemini-1.5-flash, or gemini-1.5-pro)
GEMINI_MODEL=gemini-2.5-flash

# Optional: Custom Local VQA / Grounding cluster endpoints (only needed if API_MODE=custom)
ROUTER_URL=http://localhost:8001/router
CAPTION_URL=http://localhost:8001/caption
GROUND_URL=http://localhost:8001/bbox
VQA_URL=http://localhost:8001/vqa
